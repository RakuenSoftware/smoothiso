#!/bin/sh
set -eu

STATE_DIR="${UI_STATE_DIR:-/run/smoothiso-ui}"
STATUS_FILE="${STATE_DIR}/status.json"

printf 'Content-Type: application/json\r\n'
printf 'Cache-Control: no-cache, no-store, must-revalidate\r\n'
printf '\r\n'

if [ -f "$STATUS_FILE" ]; then
    cat "$STATUS_FILE"
else
    printf 'null\n'
fi
