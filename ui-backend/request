#!/bin/sh
set -eu

REQUEST_DIR="${UI_REQUEST_DIR:-/run/smoothiso-ui/requests}"

send_json() {
    printf 'Content-Type: application/json\r\n'
    printf 'Cache-Control: no-cache, no-store, must-revalidate\r\n'
    printf '\r\n'
    printf '%s\n' "$1"
}

if [ ! -d "$REQUEST_DIR" ]; then
    send_json "null"
    exit 0
fi

REQ_FILE=""
for path in $(ls -1 "$REQUEST_DIR"/*.json 2>/dev/null); do
    REQ_FILE="$path"
    break
done

if [ -z "$REQ_FILE" ] || [ ! -f "$REQ_FILE" ]; then
    send_json "null"
    exit 0
fi

printf 'Content-Type: application/json\r\n'
printf 'Cache-Control: no-cache, no-store, must-revalidate\r\n'
printf '\r\n'
cat "$REQ_FILE"
